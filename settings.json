{
    "version": "REAL 4.0",
    "threads": 3,
    "delay_min": 5.0,
    "delay_max": 10.0,
    "timeout": 30,
    "max_retries": 3,
    "headless": false,
    "use_proxy": false,
    "use_selenium": true,
